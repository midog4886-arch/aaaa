{
  "appId": "com.champions.academy.member",
  "appName": "أكاديمية أداء الأبطال العالمية للرياضة",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"],
    "url": "https://adaa-alabtal.replit.app",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#111827",
      "showSpinner": true,
      "spinnerColor": "#F59E0B",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#030712"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#030712",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
