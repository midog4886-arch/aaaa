packages = ["android-tools", "cacert", "cargo", "freetype", "glibcLocales", "jdk17", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "rustc", "tcl", "tk", "unzip", "zip", "zlib"]

[userenv]

[userenv.shared]
DB_NAME = "champions_academy"
JWT_SECRET_KEY = "champions-academy-jwt-secret-2024"
