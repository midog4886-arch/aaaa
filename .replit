modules = ["nodejs-20", "python-3.12", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "rustc", "tcl", "tk", "zlib", "unzip", "mongosh", "mongodb-tools"]

[userenv]

[userenv.shared]
DB_NAME = "champions_academy"
JWT_SECRET_KEY = "champions-academy-jwt-secret-2024"
VAPID_PUBLIC_KEY = "BD1x3FoYU6NwF4SQJs_z2W5ib6nA7v9oRZkzILE2FTjUmo9OYv4eOhwZBcf7oU7pZFik7Ou33Bp0mmuCyX-I2cM"
VAPID_PRIVATE_KEY = "JkK8NjsSbbCtkh1PkPylXfAjvXZFeS9XPb2oYGjYEU0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/backend && python -m uvicorn server:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "5000", "--app-dir", "/home/runner/workspace/backend"]
